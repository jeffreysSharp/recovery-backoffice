<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Recovery.BackOffice.DbMigrator</RootNamespace>
    <AssemblyName>Recovery.BackOffice.DbMigrator</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Container configuration — published as a one-shot job image used as
         the migrate step in a Kubernetes Job / Helm pre-install hook / Aspire
         dependency. Same base image as the API for parity. Image is built via
         `dotnet publish /t:PublishContainer` — no PublishProfile needed (the
         legacy "DefaultContainer" profile auto-populates ContainerImageTag
         from $(Version), colliding with ContainerImageTags). -->
    <ContainerUser>1654</ContainerUser>
    <ContainerFamily>noble</ContainerFamily>
    <ContainerRepository>recovery-db-migrator</ContainerRepository>

    <!-- This is an internal operator-facing CLI — no localization, all
         operator messages are literal strings. CA1303 (use resource tables
         for user-facing strings) is the wrong rule for this project. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Web\Recovery.BackOffice.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\Modules\Auditing\Recovery.BackOffice.Modules.Auditing\Recovery.BackOffice.Modules.Auditing.csproj" />
    <ProjectReference Include="..\..\Modules\Auditing\Recovery.BackOffice.Modules.Auditing.Contracts\Recovery.BackOffice.Modules.Auditing.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Billing\Recovery.BackOffice.Modules.Billing\Recovery.BackOffice.Modules.Billing.csproj" />
    <ProjectReference Include="..\..\Modules\Billing\Recovery.BackOffice.Modules.Billing.Contracts\Recovery.BackOffice.Modules.Billing.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Recovery.BackOffice.Modules.Catalog\Recovery.BackOffice.Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Recovery.BackOffice.Modules.Catalog.Contracts\Recovery.BackOffice.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Chat\Recovery.BackOffice.Modules.Chat\Recovery.BackOffice.Modules.Chat.csproj" />
    <ProjectReference Include="..\..\Modules\Chat\Recovery.BackOffice.Modules.Chat.Contracts\Recovery.BackOffice.Modules.Chat.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Files\Recovery.BackOffice.Modules.Files\Recovery.BackOffice.Modules.Files.csproj" />
    <ProjectReference Include="..\..\Modules\Files\Recovery.BackOffice.Modules.Files.Contracts\Recovery.BackOffice.Modules.Files.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Recovery.BackOffice.Modules.Identity\Recovery.BackOffice.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\Modules\Multitenancy\Recovery.BackOffice.Modules.Multitenancy\Recovery.BackOffice.Modules.Multitenancy.csproj" />
    <ProjectReference Include="..\..\Modules\Tickets\Recovery.BackOffice.Modules.Tickets\Recovery.BackOffice.Modules.Tickets.csproj" />
    <ProjectReference Include="..\..\Modules\Tickets\Recovery.BackOffice.Modules.Tickets.Contracts\Recovery.BackOffice.Modules.Tickets.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Webhooks\Recovery.BackOffice.Modules.Webhooks\Recovery.BackOffice.Modules.Webhooks.csproj" />
    <ProjectReference Include="..\Recovery.BackOffice.Migrations.PostgreSQL\Recovery.BackOffice.Migrations.PostgreSQL.csproj" />
  </ItemGroup>

  <!-- Share configuration with the API so connection strings + tenant options
       stay in lock-step. Production deployments override via env vars. -->
  <ItemGroup>
    <None Include="..\Recovery.BackOffice.Api\appsettings.json"
          Link="appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Recovery.BackOffice.Api\appsettings.Development.json"
          Link="appsettings.Development.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
