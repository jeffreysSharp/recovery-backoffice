<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Recovery.BackOffice.Api</RootNamespace>
		<AssemblyName>Recovery.BackOffice.Api</AssemblyName>
		<IsPackable>false</IsPackable>

		<!-- Container configuration — image is built via `dotnet publish /t:PublishContainer`.
		     No PublishProfile needed (the legacy "DefaultContainer" profile auto-populates
		     ContainerImageTag from $(Version), which collides with ContainerImageTags). -->
		<ContainerPort>8080</ContainerPort>
		<ContainerUser>1654</ContainerUser>
		<ContainerFamily>noble</ContainerFamily>
		<ContainerRepository>recovery-api</ContainerRepository>

		<!-- The chiseled runtime image ships without ICU and sets DOTNET_SYSTEM_GLOBALIZATION_INVARIANT,
		     where only predefined cultures may be created, so request localization's new CultureInfo("pt-BR")
		     kills startup. Named cultures are all it needs: resource lookup goes by name, and formatting is
		     pinned to InvariantCulture by design (see UseRecoveryLocalization). -->
		<PredefinedCulturesOnly>false</PredefinedCulturesOnly>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Mediator.Abstractions" />
		<PackageReference Include="Mediator.SourceGenerator">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
  </ItemGroup>

