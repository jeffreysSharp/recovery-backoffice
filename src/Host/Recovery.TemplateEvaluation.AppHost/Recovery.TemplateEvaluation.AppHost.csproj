<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9fe5df9a-b9b2-4202-bdb4-d30b01b71d1a</UserSecretsId>
    <IsPackable>false</IsPackable>
    <!-- ASPIRE010 (13.5+): we run via `dotnet run` with NuGet-restored DCP/dashboard, not the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recovery.TemplateEvaluation.Api\Recovery.TemplateEvaluation.Api.csproj" />
    <ProjectReference Include="..\Recovery.TemplateEvaluation.DbMigrator\Recovery.TemplateEvaluation.DbMigrator.csproj" />
  </ItemGroup>

</Project>
